# Pinned inputs of the agent image. cmd/agent-bump rewrites this file;
# build.sh passes every line to docker build as a --build-arg.

# The base image: ubuntu:${UBUNTU_VERSION}, its multi-arch index by digest.
UBUNTU_VERSION=26.04
UBUNTU_CODENAME=resolute
UBUNTU_DIGEST=sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
# apt installs from snapshot.ubuntu.com at this instant, so a rebuild gets the same packages.
APT_SNAPSHOT=20261101T000000Z

# Every file's timestamp in the image, at most (BuildKit's rewrite-timestamp),
# so that a layer built from the same inputs has the same digest on any
# runner, any day: a bump re-pulls only the layers it changed. Never bump.
SOURCE_DATE_EPOCH=1767225600

# Docker Engine from Docker's apt repository (signed with this key), whose
# releases reach it before Ubuntu's universe package.
DOCKER_GPG_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570
DOCKER_CE_VERSION=5:29.9.2-1~ubuntu.26.04~resolute
CONTAINERD_VERSION=2.4.2-3~ubuntu.26.04~resolute
DOCKER_BUILDX_VERSION=0.38.1-1~ubuntu.26.04~resolute
DOCKER_COMPOSE_VERSION=5.7.0-1~ubuntu.26.04~resolute

